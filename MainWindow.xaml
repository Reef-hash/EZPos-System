<mah:MetroWindow x:Class="EZPos.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        Title="EZPos"
        Icon="/Resources/Icons/app.ico"
        MinHeight="700"
        MinWidth="1100"
        Height="800"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource DashboardBackgroundBrush}"
        GlowBrush="{StaticResource DashboardPrimaryBrush}"
        BorderBrush="{StaticResource DashboardBorderBrush}"
        BorderThickness="1"
        WindowTitleBrush="{StaticResource DashboardSurfaceBrush}"
        NonActiveWindowTitleBrush="{StaticResource DashboardSurfaceBrush}"
        NonActiveBorderBrush="{StaticResource DashboardBorderBrush}"
        TitleCharacterCasing="Normal">

    <mah:MetroWindow.TitleTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                <Image Source="/Resources/Icons/app.ico" Width="20" Height="20" Margin="0,0,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="EZPos" FontWeight="Bold" FontSize="13"
                           Foreground="{StaticResource DashboardTextPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text=" — Point of Sale" FontSize="12"
                           Foreground="{StaticResource DashboardTextMutedBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
            </StackPanel>
        </DataTemplate>
    </mah:MetroWindow.TitleTemplate>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══ Sidebar ══ -->
        <Border Grid.Column="0" Background="{StaticResource DashboardSurfaceBrush}" Padding="14,10,14,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12" />

                <StackPanel Grid.Row="1">
                    <Button x:Name="DashboardNavBtn" Style="{StaticResource NavButtonStyle}" Content="Dashboard" Tag="Dashboard" Click="NavButton_Click" />
                    <Button x:Name="SalesNavBtn" Style="{StaticResource NavButtonStyle}" Content="Sales" Tag="Sales" Click="NavButton_Click" />
                    <Button x:Name="ProductsNavBtn" Style="{StaticResource NavButtonStyle}" Content="Products" Tag="Products" Click="NavButton_Click" />
                    <Button x:Name="StockNavBtn" Style="{StaticResource NavButtonStyle}" Content="Stock" Tag="Stock" Click="NavButton_Click" />
                    <Button x:Name="ReportsNavBtn" Style="{StaticResource NavButtonStyle}" Content="Reports" Tag="Reports" Click="NavButton_Click" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Button x:Name="SettingsNavBtn" Style="{StaticResource SecondaryButtonStyle}" Height="40" Padding="12,8" Margin="0,0,0,8" Click="SettingsButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Cog" Margin="0,0,8,0" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Height="40" Padding="12,8" Click="AboutButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="CircleInfo" Margin="0,0,8,0" />
                            <TextBlock Text="About" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource DashboardBackgroundBrush}" Padding="14">
            <ContentControl x:Name="MainContent" />
        </Border>
    </Grid>
</mah:MetroWindow>
