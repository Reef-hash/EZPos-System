<UserControl x:Class="EZPos.UI.Pages.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:EZPos.UI.Pages"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             Background="{StaticResource DashboardBackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="ReportDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="36" />
            <Setter Property="Width" Value="128" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource DashboardTextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource DashboardSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DashboardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectedDateFormat" Value="Short" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="{StaticResource DashboardTextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource DashboardSurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="PageRoot"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.3"/>
                <DoubleAnimation Storyboard.TargetName="PageTranslate"
                                 Storyboard.TargetProperty="Y"
                                 From="16" To="0" Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard></BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid x:Name="PageRoot">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="PageTranslate" Y="0"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header with Date Range -->
            <RowDefinition Height="Auto"/>
            <!-- KPI Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Estimated Profit Band (hidden when no cost data) -->
            <RowDefinition Height="Auto"/>
            <!-- Charts Section -->
            <RowDefinition Height="*"/>
            <!-- Additional Analytics -->
        </Grid.RowDefinitions>

        <!-- ============================================ -->
        <!-- HEADER - DATE RANGE SELECTOR                -->
        <!-- ============================================ -->
        <materialDesign:Card Grid.Row="0" Padding="22,18" Margin="0,0,0,16" Background="{StaticResource DashboardSurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" Height="26" CornerRadius="2" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#7C3AED" Offset="0"/>
                                <GradientStop Color="#A78BFA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Analytics &amp; Reports"
                                  Foreground="{StaticResource DashboardTextPrimaryBrush}"
                                  FontSize="20" FontWeight="Bold" />
                        <TextBlock x:Name="DateRangeLabel" Text="Today"
                                  Foreground="{StaticResource DashboardTextSecondaryBrush}"
                                  FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Date Range Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="PeriodCombo"
                             Width="130"
                             Height="36"
                             Margin="0,0,8,0"
                             SelectionChanged="PeriodCombo_SelectionChanged">
                        <ComboBoxItem IsSelected="True">Today</ComboBoxItem>
                        <ComboBoxItem>Yesterday</ComboBoxItem>
                        <ComboBoxItem>This Week</ComboBoxItem>
                        <ComboBoxItem>Last Week</ComboBoxItem>
                        <ComboBoxItem>This Month</ComboBoxItem>
                        <ComboBoxItem>Last Month</ComboBoxItem>
                        <ComboBoxItem>Last 3 Months</ComboBoxItem>
                        <ComboBoxItem>Custom</ComboBoxItem>
                    </ComboBox>

                    <TextBlock Text="From" Foreground="{StaticResource TextSecondaryBrush}"
                              FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="StartDatePicker"
                               Style="{StaticResource ReportDatePickerStyle}"
                               SelectedDate="{x:Static system:DateTime.Today}"
                               Margin="0,0,8,0"/>

                    <TextBlock Text="To" Foreground="{StaticResource TextSecondaryBrush}"
                              FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="EndDatePicker"
                               Style="{StaticResource ReportDatePickerStyle}"
                               SelectedDate="{x:Static system:DateTime.Today}"
                               Margin="0,0,8,0"/>

                    <Button Style="{StaticResource DashboardRaisedButton}"
                           Height="36"
                           Padding="12,8"
                           Margin="0,0,8,0"
                           Click="FilterButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="MagnifyingGlass" Margin="0,0,6,0" FontSize="12"/>
                            <TextBlock Text="Filter"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource DashboardRaisedButton}"
                           Height="36"
                           Padding="12,8"
                           Click="ExportButton_Click">
                        <TextBlock Text="Export"/>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- ============================================ -->
        <!-- KPI SUMMARY CARDS                           -->
        <!-- ============================================ -->
        <Border Grid.Row="1" Padding="0,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Sales Card -->
                <materialDesign:Card Grid.Column="0" Padding="22,18" Margin="0,0,8,0" Background="{StaticResource DashboardSurfaceBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <fa:IconBlock Icon="DollarSign" FontSize="14" Foreground="{StaticResource DashboardAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Total Sales" Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TotalSalesValue" Text="RM 0.00" Foreground="{StaticResource DashboardAccentBrush}"
                                  FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Total Orders Card -->
                <materialDesign:Card Grid.Column="1" Padding="22,18" Margin="0,0,8,0" Background="{StaticResource DashboardSurfaceBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <fa:IconBlock Icon="Receipt" FontSize="14" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Total Orders" Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TotalOrdersValue" Text="0" Foreground="#38BDF8"
                                  FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Average Order Value Card -->
                <materialDesign:Card Grid.Column="2" Padding="22,18" Margin="0,0,8,0" Background="{StaticResource DashboardSurfaceBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <fa:IconBlock Icon="ArrowTrendUp" FontSize="14" Foreground="#FCD34D" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Avg Order Value" Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="AvgOrderValue" Text="RM 0.00" Foreground="#FCD34D"
                                  FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Transactions Card -->
                <materialDesign:Card Grid.Column="3" Padding="22,18" Margin="0" Background="{StaticResource DashboardSurfaceBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <fa:IconBlock Icon="Clock" FontSize="14" Foreground="#34D399" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Transactions" Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TransactionsValue" Text="0" Foreground="#34D399"
                                  FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </Border>

        <!-- Estimated Profit KPI row — only visible when cost price data exists -->
        <Border x:Name="EstProfitCard" Grid.Row="2" Padding="0,8,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Est. Gross Profit -->
                <materialDesign:Card Grid.Column="0" Padding="22,18" Margin="0,0,8,0" Background="{StaticResource DashboardSurfaceBrush}" BorderBrush="#3D22C55E" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <fa:IconBlock Icon="Coins" FontSize="14" Foreground="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Est. Gross Profit" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="EstProfitValue" Text="RM 0.00" Foreground="#22C55E" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Profit Margin % -->
                <materialDesign:Card Grid.Column="1" Padding="22,18" Margin="0,0,8,0" Background="{StaticResource DashboardSurfaceBrush}" BorderBrush="#3D22C55E" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <fa:IconBlock Icon="Percent" FontSize="14" Foreground="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Profit Margin" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="EstMarginValue" Text="0.0%" Foreground="#22C55E" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Note -->
                <materialDesign:Card Grid.Column="2" Padding="22,18" Margin="0" Background="{StaticResource DashboardSurfaceBrush}" BorderBrush="#3D22C55E" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="EstProfitNote" Text="&#9432; Estimated based on products with cost price set. Products without a cost price are excluded." 
                                   Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- CHARTS SECTION                              -->
        <!-- ============================================ -->
        <Border Grid.Row="3" Padding="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <!-- Sales Trend Chart -->
                    <ColumnDefinition Width="*"/>
                    <!-- Top Products -->
                </Grid.ColumnDefinitions>

                <!-- Sales Trend Chart Area -->
                <materialDesign:Card Grid.Column="0" Padding="22,18" Margin="0,0,8,0" Background="{StaticResource DashboardSurfaceBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <fa:IconBlock Icon="BarChart" FontSize="13" Foreground="{StaticResource DashboardAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Daily Sales Trend (Last 7 Days)" Foreground="{StaticResource DashboardTextPrimaryBrush}"
                                      FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Chart Simulation with Bars -->
                        <ItemsControl x:Name="SalesTrendChart" Height="200">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="200">
                                        <Border Background="{Binding BarColor}" CornerRadius="2" 
                                               Width="24" Height="{Binding BarHeight}" Margin="0,0,0,20"
                                               VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSecondaryBrush}" 
                                                  FontSize="9" TextAlignment="Center"/>
                                        <TextBlock Text="{Binding Value, StringFormat='RM {0}'}" 
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  FontSize="10" FontWeight="SemiBold" TextAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Payment Methods Breakdown -->
                <materialDesign:Card Grid.Column="1" Padding="22,18" Margin="0" Background="{StaticResource DashboardSurfaceBrush}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <fa:IconBlock Icon="CreditCard" FontSize="13" Foreground="{StaticResource DashboardAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Payment Methods" Foreground="{StaticResource DashboardTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Cash -->
                        <StackPanel Orientation="Vertical" Margin="0,0,0,12">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Cash" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="48%" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            </Grid>
                            <ProgressBar Height="6" Foreground="{StaticResource SuccessBrush}" Background="{StaticResource BorderBrush}"
                                        Value="48" Maximum="100"/>
                        </StackPanel>

                        <!-- Card -->
                        <StackPanel Orientation="Vertical" Margin="0,0,0,12">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Card" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="35%" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            </Grid>
                            <ProgressBar Height="6" Foreground="{StaticResource InfoBrush}" Background="{StaticResource BorderBrush}"
                                        Value="35" Maximum="100"/>
                        </StackPanel>

                        <!-- QR Code -->
                        <StackPanel Orientation="Vertical" Margin="0,0,0,12">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="QR Code" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="15%" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            </Grid>
                            <ProgressBar Height="6" Foreground="{StaticResource PrimaryBrush}" Background="{StaticResource BorderBrush}"
                                        Value="15" Maximum="100"/>
                        </StackPanel>

                        <!-- Cheque -->
                        <StackPanel Orientation="Vertical" Margin="0,0,0,12">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Cheque" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="2%" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                            </Grid>
                            <ProgressBar Height="6" Foreground="{StaticResource WarningBrush}" Background="{StaticResource BorderBrush}"
                                        Value="2" Maximum="100"/>
                        </StackPanel>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,8,0,8"/>

                        <TextBlock Text="Total Transactions" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                        <TextBlock Text="287 transactions" Foreground="{StaticResource TextPrimaryBrush}" 
                                  FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- TOP PRODUCTS & ADDITIONAL INFO              -->
        <!-- ============================================ -->
        <materialDesign:Card Grid.Row="4" Padding="22,18" Margin="0" Background="{StaticResource DashboardSurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Top Selling Products -->
                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <fa:IconBlock Icon="Trophy" FontSize="13" Foreground="#FCD34D" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Top Selling Products" Foreground="{StaticResource DashboardTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <DataGrid x:Name="TopProductsGrid" 
                             Style="{StaticResource DashboardDataGrid}"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             Height="200"
                             RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Revenue" Binding="{Binding Revenue, StringFormat='RM {0:F2}'}" Width="100" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!-- Hourly Summary -->
                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <fa:IconBlock Icon="Clock" FontSize="13" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Peak Hours" Foreground="{StaticResource DashboardTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <DataGrid x:Name="PeakHoursGrid" 
                             Style="{StaticResource DashboardDataGrid}"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             Height="200"
                             RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeSlot}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Orders" Binding="{Binding Orders}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Sales (RM)" Binding="{Binding Sales, StringFormat='F2'}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
