<UserControl x:Class="EZPos.UI.Pages.ProductsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:EZPos.UI.Pages"
             Background="{StaticResource DashboardBackgroundBrush}">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="PageRoot"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.3"/>
                <DoubleAnimation Storyboard.TargetName="PageTranslate"
                                 Storyboard.TargetProperty="Y"
                                 From="16" To="0" Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard></BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid x:Name="PageRoot">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="PageTranslate" Y="0"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Padding="22,18" Margin="0,0,0,16" Background="{StaticResource DashboardSurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" Height="26" CornerRadius="2" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#F59E0B" Offset="0"/>
                                <GradientStop Color="#FCD34D" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Products" Foreground="{StaticResource DashboardTextPrimaryBrush}" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Manage product catalogue and stock readiness." Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="CartCounterText" Grid.Column="1" Foreground="{StaticResource DashboardTextSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="1" Padding="22,18" Margin="0" Background="{StaticResource DashboardSurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="SearchBox"
                             Width="280"
                             Height="36"
                             Margin="0,0,8,8"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown" />

                    <ComboBox x:Name="FilterCombo"
                              Width="150"
                              Height="36"
                              Margin="0,0,8,8"
                              SelectionChanged="FilterCombo_SelectionChanged">
                        <ComboBoxItem IsSelected="True">All Products</ComboBoxItem>
                        <ComboBoxItem>In Stock</ComboBoxItem>
                        <ComboBoxItem>Low Stock</ComboBoxItem>
                        <ComboBoxItem>Out of Stock</ComboBoxItem>
                    </ComboBox>

                    <Button Style="{StaticResource DashboardRaisedButton}" Padding="12,8" Margin="0,0,8,8" Click="AddProduct_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Plus" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Add Product" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" Margin="0,0,8,8" Click="EditProduct_Click">Edit</Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" Margin="0,0,8,8" Click="DeleteProduct_Click">Delete</Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" Margin="0,0,8,8" Click="ManageCategories_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Tag" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Categories" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" Margin="0,0,8,8" Click="RefreshProducts_Click">Refresh</Button>
                    <Button x:Name="ToggleCostColumnBtn"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,8" Margin="0,0,8,8"
                            Click="ToggleCostColumn_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="EyeSlash" x:Name="ToggleCostIcon" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock x:Name="ToggleCostText" Text="Show Cost" />
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="TotalProductsText" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,8" />
                </StackPanel>
                </ScrollViewer>

                <DataGrid x:Name="ProductsGrid"
                          Grid.Row="1"
                          Style="{StaticResource DashboardDataGrid}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          MouseDoubleClick="ProductsGrid_DoubleClick"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Barcode"   Binding="{Binding Barcode}"   Width="1.4*" ElementStyle="{StaticResource DgCellText}" />
                        <DataGridTextColumn Header="Name"     Binding="{Binding Name}"     Width="2.4*" ElementStyle="{StaticResource DgCellText}" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1.4*" ElementStyle="{StaticResource DgCellText}" />
                        <DataGridTextColumn Header="Price"    Binding="{Binding Price, StringFormat='RM {0:F2}'}" Width="1*" ElementStyle="{StaticResource DgCellText}" />
                        <DataGridTextColumn x:Name="CostPriceColumn"
                                            Header="Cost Price"
                                            Binding="{Binding CostPrice, StringFormat='RM {0:F2}', TargetNullValue=''}"
                                            Width="1*"
                                            Visibility="Collapsed"
                                            ElementStyle="{StaticResource DgCellText}" />
                        <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="0.8*" ElementStyle="{StaticResource DgCellText}" />

                        <DataGridTemplateColumn Header="Status" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StockStatus, Converter={x:Static local:ProductStatusBrushConverter.Instance}}"
                                            CornerRadius="4"
                                            Padding="8,2"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding StockStatus}" Foreground="White" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Actions" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="View"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="8,4"
                                            FontSize="11"
                                            Tag="{Binding}"
                                            Click="ViewProduct_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
