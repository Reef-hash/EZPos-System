<UserControl x:Class="EZPos.UI.Pages.StockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:EZPos.UI.Pages"
             Background="{StaticResource DashboardBackgroundBrush}">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="PageRoot"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.3"/>
                <DoubleAnimation Storyboard.TargetName="PageTranslate"
                                 Storyboard.TargetProperty="Y"
                                 From="16" To="0" Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard></BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid x:Name="PageRoot">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="PageTranslate" Y="0"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Padding="22,18" Margin="0,0,0,16" Background="{StaticResource DashboardSurfaceBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="26" CornerRadius="2" Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F59E0B" Offset="0"/>
                            <GradientStop Color="#FCD34D" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel>
                    <TextBlock Text="Stock" FontSize="20" FontWeight="Bold" Foreground="{StaticResource DashboardTextPrimaryBrush}" />
                    <TextBlock Text="Monitor stock levels and reorder risk from a single inventory view." FontSize="12" Foreground="{StaticResource DashboardTextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card Grid.Column="0" Padding="22,18" Margin="0,0,8,0" Background="{StaticResource DashboardSurfaceBrush}">
                <StackPanel>
                    <TextBlock Text="In Stock" Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="12" />
                    <TextBlock x:Name="InStockValue" Foreground="#34D399" FontWeight="Bold" FontSize="24" Margin="0,8,0,0" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="1" Padding="22,18" Margin="0,0,8,0" Background="{StaticResource DashboardSurfaceBrush}">
                <StackPanel>
                    <TextBlock Text="Low Stock" Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="12" />
                    <TextBlock x:Name="LowStockValue" Foreground="#FCD34D" FontWeight="Bold" FontSize="24" Margin="0,8,0,0" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2" Padding="22,18" Margin="0,0,8,0" Background="{StaticResource DashboardSurfaceBrush}">
                <StackPanel>
                    <TextBlock Text="Out of Stock" Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="12" />
                    <TextBlock x:Name="OutOfStockValue" Foreground="#EF4444" FontWeight="Bold" FontSize="24" Margin="0,8,0,0" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="3" Padding="22,18" Margin="0" Background="{StaticResource DashboardSurfaceBrush}">
                <StackPanel>
                    <TextBlock Text="Total Units" Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="12" />
                    <TextBlock x:Name="TotalUnitsValue" Foreground="{StaticResource DashboardAccentBrush}" FontWeight="Bold" FontSize="24" Margin="0,8,0,0" />
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <materialDesign:Card Grid.Row="2" Padding="22,18" Margin="0" Background="{StaticResource DashboardSurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="StockSearchBox"
                             Width="260"
                             Height="36"
                             Margin="0,0,8,8"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged" />

                    <ComboBox x:Name="StockFilterCombo"
                              Width="160"
                              Height="36"
                              Margin="0,0,8,8"
                              SelectionChanged="StockFilterCombo_SelectionChanged">
                        <ComboBoxItem IsSelected="True">All Stock Levels</ComboBoxItem>
                        <ComboBoxItem>In Stock</ComboBoxItem>
                        <ComboBoxItem>Low Stock</ComboBoxItem>
                        <ComboBoxItem>Out of Stock</ComboBoxItem>
                    </ComboBox>

                    <ComboBox x:Name="CategoryFilterCombo"
                              Width="160"
                              Height="36"
                              Margin="0,0,8,8"
                              SelectionChanged="CategoryFilterCombo_SelectionChanged">
                        <!-- Items populated dynamically from CategoryService -->
                    </ComboBox>

                    <Button Style="{StaticResource DashboardRaisedButton}" Padding="12,8" Margin="0,0,8,8" Click="StockIn_Click">Stock In</Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" Margin="0,0,8,8" Click="StockOut_Click">Stock Out</Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" Margin="0,0,8,8" Click="Refresh_Click">Refresh</Button>
                </StackPanel>
                </ScrollViewer>

                <DataGrid x:Name="InventoryGrid"
                          Grid.Row="1"
                          Style="{StaticResource DashboardDataGrid}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"    Binding="{Binding Name}"         Width="2*"   ElementStyle="{StaticResource DgCellText}" />
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}"       Width="1.2*" ElementStyle="{StaticResource DgCellText}" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}"    Width="1.2*" ElementStyle="{StaticResource DgCellText}" />
                        <DataGridTextColumn Header="Current" Binding="{Binding Stock}"        Width="0.8*" ElementStyle="{StaticResource DgCellText}" />
                        <DataGridTextColumn Header="Reorder" Binding="{Binding ReorderLevel}" Width="0.8*" ElementStyle="{StaticResource DgCellText}" />

                        <DataGridTemplateColumn Header="Level" Width="1.8*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <ProgressBar Height="7" Maximum="100" Value="{Binding StockPercentage, Mode=OneWay}" Background="{StaticResource BorderBrush}" Foreground="{StaticResource PrimaryBrush}" />
                                        <TextBlock Text="{Binding StockPercentage, StringFormat='{}{0}%'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Status" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StockStatus, Converter={x:Static local:StockStatusBrushConverter.Instance}}"
                                            CornerRadius="4"
                                            Padding="8,2"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding StockStatus}" Foreground="White" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Updated" Binding="{Binding LastUpdated, StringFormat='{}{0:dd/MM/yyyy}'}" Width="1.1*" ElementStyle="{StaticResource DgCellText}" />

                        <DataGridTemplateColumn Header="Actions" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Edit"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="8,4"
                                            FontSize="11"
                                            Tag="{Binding}"
                                            Click="EditStock_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
