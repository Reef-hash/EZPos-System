<UserControl x:Class="EZPos.UI.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource DashboardBackgroundBrush}">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="PageRoot"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.3"/>
                <DoubleAnimation Storyboard.TargetName="PageTranslate"
                                 Storyboard.TargetProperty="Y"
                                 From="16" To="0" Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard></BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid x:Name="PageRoot">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="PageTranslate" Y="0"/>
        </Grid.RenderTransform>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0">

            <!-- Header -->
            <materialDesign:Card Padding="22,18" Margin="0,0,0,16"
                                 Background="{StaticResource DashboardSurfaceBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="26" CornerRadius="2" Margin="0,0,14,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#7C3AED" Offset="0"/>
                                    <GradientStop Color="#A78BFA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Settings" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource DashboardTextPrimaryBrush}" />
                            <TextBlock Text="Configure store information, printer, and system preferences."
                                       FontSize="12" Foreground="{StaticResource DashboardTextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1"
                            x:Name="SaveButton"
                            Style="{StaticResource DashboardRaisedButton}"
                            Padding="20,8"
                            Click="SaveButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Save" Margin="0,0,8,0" />
                            <TextBlock Text="Save Changes" />
                        </StackPanel>
                    </Button>
                </Grid>
            </materialDesign:Card>

            <!-- Store Information -->
            <materialDesign:Card Padding="22,18" Margin="0,0,0,16"
                                 Background="{StaticResource DashboardSurfaceBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <fa:IconBlock Icon="Store" FontSize="16"
                                      Foreground="{StaticResource DashboardPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Store Information" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource DashboardTextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" MaxWidth="420" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Store Name"
                                   Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="StoreNameBox"
                                 materialDesign:HintAssist.Hint="Store name" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Receipt Footer Message"
                                   Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="ReceiptFooterBox"
                                 materialDesign:HintAssist.Hint="Printed at the bottom of receipts" />
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Printer -->
            <materialDesign:Card Padding="22,18" Margin="0,0,0,16"
                                 Background="{StaticResource DashboardSurfaceBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <fa:IconBlock Icon="Print" FontSize="16"
                                      Foreground="{StaticResource DashboardPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Receipt Printer" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource DashboardTextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" MaxWidth="420" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Printer Name"
                                   Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="PrinterNameBox"
                                 materialDesign:HintAssist.Hint="Printer name (leave blank to disable)"
                                 Margin="0,0,8,0" />
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,8" Click="DetectPrinters_Click">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Icon="Search" Margin="0,0,6,0" />
                                <TextBlock Text="Detect" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="PrinterHintText"
                               Text="Leave blank to disable receipt printing."
                               Foreground="{StaticResource DashboardTextMutedBrush}" FontSize="11" Margin="220,6,0,0" />
                    <CheckBox x:Name="AutoPrintCheckBox"
                              Content="Auto-print receipt after checkout"
                              Foreground="{StaticResource DashboardTextSecondaryBrush}"
                              FontSize="13" Margin="220,10,0,0" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Sales and Tax -->
            <materialDesign:Card Padding="22,18" Margin="0,0,0,16"
                                 Background="{StaticResource DashboardSurfaceBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <fa:IconBlock Icon="Percent" FontSize="16"
                                      Foreground="{StaticResource DashboardPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Sales &amp; Tax" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource DashboardTextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" MaxWidth="300" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tax Rate (%)"
                                   Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TaxRateBox"
                                 materialDesign:HintAssist.Hint="e.g. 7" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tax Mode"
                                   Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="TaxModeCombo">
                            <ComboBoxItem Tag="PerReceipt">Per Receipt - tax on total (default)</ComboBoxItem>
                            <ComboBoxItem Tag="PerItem">Per Item - tax per line item</ComboBoxItem>
                            <ComboBoxItem Tag="Fake">Display Only - shown on receipt, not charged</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Currency Symbol"
                                   Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="CurrencyBox"
                                 materialDesign:HintAssist.Hint="e.g. $" />
                    </Grid>
                    <TextBlock Foreground="{StaticResource DashboardTextMutedBrush}" FontSize="11"
                               Margin="220,6,0,0" Text="Tax rate change takes effect on the next sale." />
                </StackPanel>
            </materialDesign:Card>

            <!-- Keyboard Shortcuts -->
            <materialDesign:Card Padding="22,18" Margin="0,0,0,16"
                                 Background="{StaticResource DashboardSurfaceBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <fa:IconBlock Icon="Keyboard" FontSize="16"
                                      Foreground="{StaticResource DashboardPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Keyboard Shortcuts" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource DashboardTextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Payment: Cash"
                                   Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="PaymentCashHotkeyBox"
                                 materialDesign:HintAssist.Hint="e.g. F1" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Payment: QR"
                                   Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="PaymentQrHotkeyBox"
                                 materialDesign:HintAssist.Hint="e.g. F2" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Payment: Card"
                                   Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="PaymentCardHotkeyBox"
                                 materialDesign:HintAssist.Hint="e.g. F3" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Payment: Cheque"
                                   Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="PaymentChequeHotkeyBox"
                                 materialDesign:HintAssist.Hint="e.g. F4" />
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Receipt: New Sale"
                                   Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                        <TextBox Grid.Row="8" Grid.Column="1" x:Name="ReceiptNewSaleHotkeyBox"
                                 materialDesign:HintAssist.Hint="e.g. PageUp" />
                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Receipt: Print"
                                   Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                        <TextBox Grid.Row="10" Grid.Column="1" x:Name="ReceiptPrintHotkeyBox"
                                 materialDesign:HintAssist.Hint="e.g. PageDown" />
                    </Grid>
                    <TextBlock Foreground="{StaticResource DashboardTextMutedBrush}" FontSize="11" Margin="220,8,0,0"
                               Text="Use key names like F1, F2, F3, F4, PageUp, PageDown, Insert, Home." />
                </StackPanel>
            </materialDesign:Card>

            <!-- Database Maintenance -->
            <materialDesign:Card Padding="22,18" Margin="0,0,0,16"
                                 Background="{StaticResource DashboardSurfaceBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <fa:IconBlock Icon="Database" FontSize="16"
                                      Foreground="{StaticResource DashboardPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Database Maintenance" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource DashboardTextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Active Database"
                                   Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DatabasePathText"
                                   Foreground="{StaticResource DashboardTextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,8" Margin="0,0,8,0" Click="BackupDatabase_Click">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconBlock Icon="Download" Margin="0,0,6,0" />
                                    <TextBlock Text="Backup Database" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,8" Click="RestoreDatabase_Click">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconBlock Icon="Upload" Margin="0,0,6,0" />
                                    <TextBlock Text="Restore Backup" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock Foreground="{StaticResource DashboardTextMutedBrush}" FontSize="11" Margin="220,8,0,0"
                               Text="Restore replaces the live database. EZPos will close after a successful restore so the restored data loads cleanly on next launch." />
                </StackPanel>
            </materialDesign:Card>

            <!-- About -->
            <materialDesign:Card Padding="22,18" Margin="0,0,0,4"
                                 Background="{StaticResource DashboardSurfaceBrush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <fa:IconBlock Icon="InfoCircle" FontSize="16"
                                      Foreground="{StaticResource DashboardPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="About" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource DashboardTextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="13" Margin="0,0,0,12">
                        <Run Text="EZPos Point of Sale System" FontWeight="SemiBold" />
                        <LineBreak />
                        <Run x:Name="VersionRun" Text="Version ..." />
                    </TextBlock>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,8" MaxWidth="200" HorizontalAlignment="Left"
                            Click="CheckForUpdates_Click" x:Name="CheckForUpdatesButton">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Download" Margin="0,0,6,0" />
                            <TextBlock Text="Check for Updates" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </materialDesign:Card>

        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>