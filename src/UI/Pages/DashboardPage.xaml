<UserControl x:Class="EZPos.UI.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource DashboardBackgroundBrush}">

    <!-- ── Page load: slide-up + fade-in, KPI cards staggered ── -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Page fade + slide -->
                    <DoubleAnimation Storyboard.TargetName="PageRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.3"/>
                    <DoubleAnimation Storyboard.TargetName="PageTranslate"
                                     Storyboard.TargetProperty="Y"
                                     From="16" To="0" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <!-- KPI Card 1 — delay 100ms -->
                    <DoubleAnimation Storyboard.TargetName="KpiCard1"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:0.10" Duration="0:0:0.35"/>
                    <DoubleAnimation Storyboard.TargetName="KpiCard1Transform"
                                     Storyboard.TargetProperty="Y"
                                     From="24" To="0" BeginTime="0:0:0.10" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <!-- KPI Card 2 — delay 200ms -->
                    <DoubleAnimation Storyboard.TargetName="KpiCard2"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:0.20" Duration="0:0:0.35"/>
                    <DoubleAnimation Storyboard.TargetName="KpiCard2Transform"
                                     Storyboard.TargetProperty="Y"
                                     From="24" To="0" BeginTime="0:0:0.20" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <!-- KPI Card 3 — delay 300ms -->
                    <DoubleAnimation Storyboard.TargetName="KpiCard3"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:0.30" Duration="0:0:0.35"/>
                    <DoubleAnimation Storyboard.TargetName="KpiCard3Transform"
                                     Storyboard.TargetProperty="Y"
                                     From="24" To="0" BeginTime="0:0:0.30" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <!-- KPI Card 4 — delay 400ms -->
                    <DoubleAnimation Storyboard.TargetName="KpiCard4"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:0.40" Duration="0:0:0.35"/>
                    <DoubleAnimation Storyboard.TargetName="KpiCard4Transform"
                                     Storyboard.TargetProperty="Y"
                                     From="24" To="0" BeginTime="0:0:0.40" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid x:Name="PageRoot">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="PageTranslate" Y="0"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header      -->
            <RowDefinition Height="Auto"/>   <!-- KPI cards   -->
            <RowDefinition Height="Auto"/>   <!-- Table title -->
            <RowDefinition Height="*"   />   <!-- Table       -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════
             HEADER
        ══════════════════════════════════════════════════ -->
        <materialDesign:Card Grid.Row="0" Padding="22,18" Margin="0,0,0,16" Background="{StaticResource DashboardSurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: accent bar + title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" Height="26" CornerRadius="2" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#7C3AED" Offset="0"/>
                                <GradientStop Color="#A78BFA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Dashboard"
                                   Foreground="{StaticResource DashboardTextPrimaryBrush}"
                                   FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="DateLabel"
                                   Foreground="{StaticResource DashboardTextSecondaryBrush}"
                                   FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Refresh button -->
                <Button Grid.Column="1" Style="{StaticResource DashboardRaisedButton}"
                        VerticalAlignment="Center" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="ArrowsRotate" FontSize="11" Margin="0,0,6,0" Foreground="White"/>
                        <TextBlock Text="Refresh" Foreground="White" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>
        </materialDesign:Card>

        <!-- ══════════════════════════════════════════════════
             KPI CARDS  (4 columns, hover lift + border glow)
        ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Card 1: Revenue (Violet) ── -->
            <Border x:Name="KpiCard1" Grid.Column="0" Margin="0,0,10,0"
                    Opacity="0" CornerRadius="12" Cursor="Hand"
                    Background="{StaticResource DashboardSurfaceBrush}"
                    BorderThickness="1">
                <Border.BorderBrush><SolidColorBrush Color="#2D2B55"/></Border.BorderBrush>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="KpiCard1Transform" Y="0"/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="KpiCard1Transform" Storyboard.TargetProperty="Y" To="-6" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <ColorAnimation  Storyboard.TargetName="KpiCard1" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#7C3AED" Duration="0:0:0.18"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="KpiCard1Transform" Storyboard.TargetProperty="Y" To="0"  Duration="0:0:0.20"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <ColorAnimation  Storyboard.TargetName="KpiCard1" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#2D2B55" Duration="0:0:0.20"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Violet gradient accent strip -->
                    <Border Grid.Row="0" CornerRadius="12,12,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#7C3AED" Offset="0"/>
                                <GradientStop Color="#A78BFA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="20,16,20,18">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#1A7C3AED" Margin="0,0,12,0">
                                <materialDesign:PackIcon Kind="CurrencyUsd" Width="17" Height="17"
                                                         Foreground="#A78BFA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Today's Revenue" Foreground="{StaticResource DashboardTextSecondaryBrush}"
                                       FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TodayRevenueText" Text="RM 0.00"
                                   Foreground="#A78BFA" FontSize="26" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="Revenue from today's sales"
                                   Foreground="{StaticResource DashboardTextMutedBrush}" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Card 2: Transactions (Sky Blue) ── -->
            <Border x:Name="KpiCard2" Grid.Column="1" Margin="0,0,10,0"
                    Opacity="0" CornerRadius="12" Cursor="Hand"
                    Background="{StaticResource DashboardSurfaceBrush}"
                    BorderThickness="1">
                <Border.BorderBrush><SolidColorBrush Color="#2D2B55"/></Border.BorderBrush>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="KpiCard2Transform" Y="0"/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="KpiCard2Transform" Storyboard.TargetProperty="Y" To="-6" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <ColorAnimation  Storyboard.TargetName="KpiCard2" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#0EA5E9" Duration="0:0:0.18"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="KpiCard2Transform" Storyboard.TargetProperty="Y" To="0"  Duration="0:0:0.20"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <ColorAnimation  Storyboard.TargetName="KpiCard2" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#2D2B55" Duration="0:0:0.20"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="12,12,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0EA5E9" Offset="0"/>
                                <GradientStop Color="#38BDF8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="20,16,20,18">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#1A0EA5E9" Margin="0,0,12,0">
                                <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="17" Height="17"
                                                         Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Transactions Today" Foreground="{StaticResource DashboardTextSecondaryBrush}"
                                       FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TodayOrdersText" Text="0"
                                   Foreground="#38BDF8" FontSize="26" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="Number of transactions"
                                   Foreground="{StaticResource DashboardTextMutedBrush}" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Card 3: Low Stock (Amber) ── -->
            <Border x:Name="KpiCard3" Grid.Column="2" Margin="0,0,10,0"
                    Opacity="0" CornerRadius="12" Cursor="Hand"
                    Background="{StaticResource DashboardSurfaceBrush}"
                    BorderThickness="1">
                <Border.BorderBrush><SolidColorBrush Color="#2D2B55"/></Border.BorderBrush>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="KpiCard3Transform" Y="0"/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="KpiCard3Transform" Storyboard.TargetProperty="Y" To="-6" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <ColorAnimation  Storyboard.TargetName="KpiCard3" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#F59E0B" Duration="0:0:0.18"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="KpiCard3Transform" Storyboard.TargetProperty="Y" To="0"  Duration="0:0:0.20"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <ColorAnimation  Storyboard.TargetName="KpiCard3" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#2D2B55" Duration="0:0:0.20"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="12,12,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F59E0B" Offset="0"/>
                                <GradientStop Color="#FCD34D" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="20,16,20,18">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#1AF59E0B" Margin="0,0,12,0">
                                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="17" Height="17"
                                                         Foreground="#FCD34D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Low Stock Items" Foreground="{StaticResource DashboardTextSecondaryBrush}"
                                       FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="LowStockCountText" Text="0"
                                   Foreground="#FCD34D" FontSize="26" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="Items requiring restock"
                                   Foreground="{StaticResource DashboardTextMutedBrush}" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Card 4: Avg Order (Emerald) ── -->
            <Border x:Name="KpiCard4" Grid.Column="3"
                    Opacity="0" CornerRadius="12" Cursor="Hand"
                    Background="{StaticResource DashboardSurfaceBrush}"
                    BorderThickness="1">
                <Border.BorderBrush><SolidColorBrush Color="#2D2B55"/></Border.BorderBrush>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="KpiCard4Transform" Y="0"/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="KpiCard4Transform" Storyboard.TargetProperty="Y" To="-6" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <ColorAnimation  Storyboard.TargetName="KpiCard4" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#10B981" Duration="0:0:0.18"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="KpiCard4Transform" Storyboard.TargetProperty="Y" To="0"  Duration="0:0:0.20"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <ColorAnimation  Storyboard.TargetName="KpiCard4" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#2D2B55" Duration="0:0:0.20"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="12,12,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#10B981" Offset="0"/>
                                <GradientStop Color="#34D399" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="20,16,20,18">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#1A10B981" Margin="0,0,12,0">
                                <materialDesign:PackIcon Kind="TrendingUp" Width="17" Height="17"
                                                         Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Avg Order Value" Foreground="{StaticResource DashboardTextSecondaryBrush}"
                                       FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="AvgOrderText" Text="RM 0.00"
                                   Foreground="#34D399" FontSize="26" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="Average per transaction"
                                   Foreground="{StaticResource DashboardTextMutedBrush}" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════
             LOW STOCK TABLE HEADER
        ══════════════════════════════════════════════════ -->
        <Border Grid.Row="2" CornerRadius="12,12,0,0" Padding="20,14"
                Background="{StaticResource DashboardSurfaceBrush}"
                BorderThickness="1,1,1,0">
            <Border.BorderBrush><SolidColorBrush Color="#2D2B55"/></Border.BorderBrush>
            <StackPanel Orientation="Horizontal">
                <!-- Amber accent bar -->
                <Border Width="4" Height="18" CornerRadius="2" Margin="0,0,12,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F59E0B" Offset="0"/>
                            <GradientStop Color="#FCD34D" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock Text="Low Stock Alerts"
                           Foreground="{StaticResource DashboardTextPrimaryBrush}"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="LowStockSubLabel"
                           Foreground="{StaticResource DashboardTextSecondaryBrush}"
                           FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════
             LOW STOCK DATAGRID
        ══════════════════════════════════════════════════ -->
        <Border Grid.Row="3" CornerRadius="0,0,12,12"
                Background="{StaticResource DashboardSurfaceBrush}"
                BorderThickness="1,0,1,1">
            <Border.BorderBrush><SolidColorBrush Color="#2D2B55"/></Border.BorderBrush>
            <DataGrid x:Name="LowStockGrid"
                      Style="{StaticResource DashboardDataGrid}"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" IsReadOnly="True"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PRODUCT"       Binding="{Binding Name}"        Width="*"/>
                    <DataGridTextColumn Header="CURRENT STOCK" Binding="{Binding Stock}"        Width="140"/>
                    <DataGridTextColumn Header="REORDER LEVEL" Binding="{Binding ReorderLevel}" Width="140"/>
                    <DataGridTemplateColumn Header="STATUS" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="10,3" HorizontalAlignment="Left" Margin="0,10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1AF59E0B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Stock}" Value="0">
                                                    <Setter Property="Background" Value="#1AEF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Low Stock"/>
                                                <Setter Property="Foreground" Value="#FCD34D"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Stock}" Value="0">
                                                        <Setter Property="Text" Value="Out of Stock"/>
                                                        <Setter Property="Foreground" Value="#FCA5A5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Empty state -->
        <Border Grid.Row="3" x:Name="EmptyAlertPanel" Visibility="Collapsed"
                CornerRadius="0,0,12,12"
                Background="{StaticResource DashboardSurfaceBrush}"
                BorderThickness="1,0,1,1">
            <Border.BorderBrush><SolidColorBrush Color="#2D2B55"/></Border.BorderBrush>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,50">
                <Border Width="56" Height="56" CornerRadius="28" Background="#1A10B981"
                        HorizontalAlignment="Center" Margin="0,0,0,14">
                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="28" Height="28"
                                             Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="All stock levels are healthy!"
                           Foreground="{StaticResource DashboardTextPrimaryBrush}"
                           FontSize="14" FontWeight="Medium" HorizontalAlignment="Center"/>
                <TextBlock Text="No items require restocking at this time."
                           Foreground="{StaticResource DashboardTextMutedBrush}"
                           FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
