<UserControl x:Class="EZPos.UI.Pages.SalesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource DashboardBackgroundBrush}">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="PageRoot"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.3"/>
                <DoubleAnimation Storyboard.TargetName="PageTranslate"
                                 Storyboard.TargetProperty="Y"
                                 From="16" To="0" Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard></BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid x:Name="PageRoot">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="PageTranslate" Y="0"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Padding="22,18" Margin="0,0,0,16" Background="{StaticResource DashboardSurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" Height="26" CornerRadius="2" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#F59E0B" Offset="0"/>
                                <GradientStop Color="#FCD34D" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Sales" FontSize="20" FontWeight="Bold" Foreground="{StaticResource DashboardTextPrimaryBrush}" />
                        <TextBlock Text="Create transactions and manage active cart items." FontSize="12" Foreground="{StaticResource DashboardTextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,8" Click="ClearCart_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="TrashAlt" Margin="0,0,8,0" />
                            <TextBlock Text="Clear Cart" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" Click="HoldCurrentTab_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="PauseCircle" Margin="0,0,8,0" />
                            <TextBlock Text="Hold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="360" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card Grid.Column="0" Padding="22,18" Margin="0,0,0,10" Background="{StaticResource DashboardSurfaceBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,12" VerticalAlignment="Top">
                        <TextBox x:Name="ProductSearchBox"
                                 MinWidth="230"
                                 Width="260"
                                 Height="36"
                                 Margin="0,0,8,8"
                                 VerticalContentAlignment="Center"
                                 TextChanged="ProductSearchBox_TextChanged"
                                 KeyDown="ProductSearchBox_KeyDown" />

                        <ComboBox x:Name="CategoryCombo"
                                  Width="170"
                                  Height="36"
                                  Margin="0,0,8,8"
                                  SelectionChanged="CategoryCombo_SelectionChanged">
                            <!-- Items populated dynamically from CategoryService in SalesPage_Loaded -->
                        </ComboBox>

                        <Button Width="110"
                                Height="36"
                                Margin="0,0,0,8"
                                Style="{StaticResource DashboardRaisedButton}"
                                Content="Search"
                                Click="SearchButton_Click" />
                    </WrapPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ProductsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="170"
                                            MinHeight="130"
                                            Margin="6"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="ProductItem_Click">
                                        <StackPanel>
                                            <fa:IconBlock Icon="BoxOpen" FontSize="24" Foreground="{StaticResource DashboardAccentBrush}" HorizontalAlignment="Center" Margin="0,2,0,8" />
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="154" ToolTip="{Binding Name}" />
                                            <TextBlock Text="{Binding Barcode}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Price, StringFormat='RM {0:F2}'}" Foreground="{StaticResource DashboardAccentBrush}" FontWeight="Bold" TextAlignment="Center" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding Stock, StringFormat='Stock: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2" Padding="22,18" Margin="0,0,0,10" Background="{StaticResource DashboardSurfaceBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Tab strip + cart header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <!-- Scrollable tab strip -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                            <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
                        </ScrollViewer>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Shopping Cart" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="16" />
                            <TextBlock x:Name="CartItemCount" Grid.Column="1" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="CartItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PosListItemStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Full-width product name — always fully readable -->
                                                <TextBlock Grid.Row="0"
                                                           Text="{Binding ProductName}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,6" />

                                                <!-- Price · qty controls · remove — all on one row -->
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding UnitPrice, StringFormat='RM {0:F2}'}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <Button Content="-" Width="34" Height="34" Padding="0" FontSize="16" Tag="{Binding ProductId}" Click="QuantityMinus_Click" />
                                                        <TextBox Width="52"
                                                                 Height="34"
                                                                 Margin="4,0"
                                                                 Text="{Binding Quantity, Mode=OneWay, StringFormat={}{0:0.###}}"
                                                                 HorizontalContentAlignment="Center"
                                                                 VerticalContentAlignment="Center"
                                                                 TextAlignment="Center"
                                                                 FontSize="14"
                                                                 FontWeight="SemiBold"
                                                                 GotKeyboardFocus="QuantityInput_GotKeyboardFocus"
                                                                 LostKeyboardFocus="QuantityInput_LostKeyboardFocus"
                                                                 KeyDown="QuantityInput_KeyDown" />
                                                        <Button Content="+" Width="34" Height="34" Padding="0" FontSize="16" Tag="{Binding ProductId}" Click="QuantityPlus_Click" />
                                                    </StackPanel>

                                                    <Button Grid.Column="3"
                                                            Content="Remove"
                                                            Padding="12,8"
                                                            FontSize="13"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Tag="{Binding ProductId}"
                                                            Click="RemoveItem_Click" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="EmptyCartMessage"
                                   Text="Cart is empty"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Border Grid.Row="2" Margin="0,10,0,0" Padding="10,10,10,0"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Total" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="CartFooterTotalText" Grid.Column="1" Foreground="{StaticResource DashboardAccentBrush}" FontWeight="Bold" FontSize="20" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Padding="14,10" Click="HoldCurrentTab_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:IconBlock Icon="PauseCircle" Margin="0,0,8,0" />
                                        <TextBlock Text="Hold" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2" Style="{StaticResource DashboardRaisedButton}" Padding="18,10" Click="Checkout_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <fa:IconBlock Icon="CashRegister" Margin="0,0,8,0" />
                                        <TextBlock x:Name="CartFooterCheckoutText" Text="Checkout" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- ── No-shift guard overlay: absorbs all input when no shift is open ── -->
        <Border x:Name="NoShiftOverlay" Grid.RowSpan="3"
                Background="#CC000000" Visibility="Collapsed"
                Panel.ZIndex="99">
            <Border MaxWidth="440"
                    Background="{StaticResource DashboardSurfaceBrush}"
                    BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="12"
                    Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <fa:IconBlock Icon="TriangleExclamation" Foreground="#F59E0B"
                                  FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="No Shift Open"
                               Foreground="{StaticResource DashboardTextPrimaryBrush}"
                               FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="A shift must be open before you can process any sales.&#x0a;Use the Cash Drawer page in the sidebar to open one."
                               Foreground="{StaticResource DashboardTextSecondaryBrush}"
                               FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>

        <materialDesign:Card Grid.Row="2" Padding="22,18" Margin="0" Background="{StaticResource DashboardSurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Items:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="SummaryItems" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="6,0,20,0" VerticalAlignment="Center" />
                    <TextBlock Text="Subtotal:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="SubtotalText" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="6,0,20,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TaxLabel" Text="Tax:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TaxText" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="6,0,16,0" VerticalAlignment="Center" />
                    <!-- Rounding adjustment — shown only for Cash, hidden otherwise -->
                    <StackPanel x:Name="RoundingRow" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="Rounding:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="RoundingAdjText" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Total:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="TotalText" Foreground="{StaticResource DashboardAccentBrush}" FontWeight="Bold" FontSize="17" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
