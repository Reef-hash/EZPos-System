<UserControl x:Class="EZPos.UI.Dialogs.LabelTemplateEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="620" Height="560">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DashboardTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="FieldGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <materialDesign:DialogHost Identifier="InnerTemplateDialog" DialogTheme="Dark">
    <Border BorderBrush="{StaticResource DashboardBorderBrush}" BorderThickness="1"
            Background="{StaticResource DashboardBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ── Title bar ── -->
            <Grid Grid.Row="0" Background="{StaticResource DashboardSurfaceBrush}" Height="44">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <fa:IconBlock Icon="Barcode" FontSize="14" Foreground="{StaticResource DashboardAccentBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="Label Templates" Foreground="{StaticResource DashboardTextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource WinCloseButtonStyle}" Width="44" Height="44" HorizontalAlignment="Right"
                        ToolTip="Close" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}">
                    <fa:IconBlock Icon="Xmark" FontSize="14" />
                </Button>
            </Grid>

            <!-- ── Content ── -->
            <Grid Grid.Row="1" Margin="18,14,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Template list -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource DashboardBorderBrush}" BorderThickness="1" CornerRadius="4">
                        <ListBox ItemsSource="{Binding Templates}" DisplayMemberPath="Name"
                                 SelectedItem="{Binding SelectedTemplate}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource DashboardTextPrimaryBrush}" FontSize="13" />
                    </Border>

                    <Button Grid.Row="1" Margin="0,8,0,0" Height="34"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding NewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Plus" FontSize="11" Margin="0,0,6,0" />
                            <TextBlock Text="New Template" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Form -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <StackPanel Style="{StaticResource FieldGroup}">
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                        <TextBox Height="32" Text="{Binding SelectedTemplate.Name, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Width (mm)" Style="{StaticResource FieldLabel}" />
                            <TextBox Height="32" Text="{Binding SelectedTemplate.LabelWidthMm, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Height (mm)" Style="{StaticResource FieldLabel}" />
                            <TextBox Height="32" Text="{Binding SelectedTemplate.LabelHeightMm, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Labels per Row" Style="{StaticResource FieldLabel}" />
                            <TextBox Height="32" Text="{Binding SelectedTemplate.LabelsPerRow, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Labels per Column" Style="{StaticResource FieldLabel}" />
                            <TextBox Height="32" Text="{Binding SelectedTemplate.LabelsPerColumn, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="FIELDS" Style="{StaticResource FieldLabel}" FontWeight="SemiBold" Margin="0,4,0,6" />
                    <WrapPanel Margin="0,0,0,10">
                        <CheckBox Content="Barcode" Margin="0,0,14,6" IsChecked="{Binding SelectedTemplate.ShowBarcode}" />
                        <CheckBox Content="Name" Margin="0,0,14,6" IsChecked="{Binding SelectedTemplate.ShowName}" />
                        <CheckBox Content="Price" Margin="0,0,14,6" IsChecked="{Binding SelectedTemplate.ShowPrice}" />
                        <CheckBox Content="Category" Margin="0,0,14,6" IsChecked="{Binding SelectedTemplate.ShowCategory}" />
                        <CheckBox Content="Store Name" Margin="0,0,14,6" IsChecked="{Binding SelectedTemplate.ShowStoreName}" />
                    </WrapPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Name Font Size" Style="{StaticResource FieldLabel}" />
                            <TextBox Height="32" Text="{Binding SelectedTemplate.FontSizeName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Price Font Size" Style="{StaticResource FieldLabel}" />
                            <TextBox Height="32" Text="{Binding SelectedTemplate.FontSizePrice, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Style="{StaticResource FieldGroup}">
                        <TextBlock Text="Custom Text (optional)" Style="{StaticResource FieldLabel}" />
                        <TextBox Height="32" Text="{Binding SelectedTemplate.CustomText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <CheckBox Content="Set as default template" Margin="0,4,0,0" IsChecked="{Binding SelectedTemplate.IsDefault}" />

                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ── Footer ── -->
            <Grid Grid.Row="2" Margin="18,8,18,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="36" Foreground="{StaticResource ErrorBrush}"
                        Command="{Binding DeleteCommand}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="TrashAlt" FontSize="12" Margin="0,0,6,0" Foreground="{StaticResource ErrorBrush}" />
                        <TextBlock Text="Delete" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource DashboardRaisedButton}"
                        Height="36" MinWidth="110" Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="FloppyDisk" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
    </materialDesign:DialogHost>
</UserControl>
