<UserControl x:Class="EZPos.UI.Dialogs.QuickPrintDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Width="420">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DashboardTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FieldGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource DashboardBackgroundBrush}"
            BorderBrush="{StaticResource DashboardBorderBrush}" BorderThickness="1"
            CornerRadius="8">
        <Grid Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ── Title ── -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <fa:IconBlock Icon="Barcode" FontSize="18"
                              Foreground="{StaticResource DashboardAccentBrush}"
                              VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="Print Label" Foreground="{StaticResource DashboardTextPrimaryBrush}"
                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>

            <!-- ── Fields ── -->
            <StackPanel Grid.Row="1">

                <StackPanel Style="{StaticResource FieldGroup}">
                    <TextBlock Text="Product" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding ProductName}" Foreground="{StaticResource DashboardTextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Style="{StaticResource FieldGroup}">
                    <TextBlock Text="Barcode" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding Barcode}" Foreground="{StaticResource DashboardTextPrimaryBrush}" FontFamily="{StaticResource MonoFont}" />
                </StackPanel>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Format" Style="{StaticResource FieldLabel}" />
                        <ComboBox Height="36" ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding SelectedFormat}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Template" Style="{StaticResource FieldLabel}" />
                        <ComboBox Height="36" ItemsSource="{Binding Templates}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedTemplate}" />
                    </StackPanel>
                </Grid>

                <StackPanel Style="{StaticResource FieldGroup}">
                    <TextBlock Text="Printer" Style="{StaticResource FieldLabel}" />
                    <ComboBox Height="36" ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" />
                </StackPanel>

                <StackPanel Style="{StaticResource FieldGroup}">
                    <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}" />
                    <TextBox Height="36" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

            </StackPanel>

            <!-- ── Buttons ── -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Content="Cancel" Height="38" Click="Cancel_Click" />

                <Button Grid.Column="2" Style="{StaticResource DashboardRaisedButton}"
                        Height="38" MinWidth="120" Click="Print_Click">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Print" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="Print" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
