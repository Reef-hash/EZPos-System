<UserControl x:Class="EZPos.UI.Dialogs.CloseShiftDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Width="480">

    <Border Margin="18" Padding="20" Background="{StaticResource DashboardSurfaceBrush}"
            BorderBrush="{StaticResource DashboardBorderBrush}" BorderThickness="1" CornerRadius="10">
        <StackPanel>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <fa:IconBlock Icon="CashRegister" Foreground="#F59E0B"
                              FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Close Shift" Foreground="{StaticResource DashboardTextPrimaryBrush}"
                           FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Session summary card -->
            <Border Background="{StaticResource DashboardBackgroundBrush}"
                    BorderBrush="{StaticResource DashboardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Opened By"
                               Foreground="{StaticResource DashboardTextMutedBrush}" FontSize="12"/>
                    <TextBlock x:Name="OpenedByText" Grid.Row="0" Grid.Column="1"
                               Foreground="{StaticResource DashboardTextPrimaryBrush}"
                               FontSize="12" HorizontalAlignment="Right"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Opened At" Margin="0,4,0,0"
                               Foreground="{StaticResource DashboardTextMutedBrush}" FontSize="12"/>
                    <TextBlock x:Name="OpenedAtText" Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"
                               Foreground="{StaticResource DashboardTextPrimaryBrush}"
                               FontSize="12" HorizontalAlignment="Right"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Opening Balance" Margin="0,4,0,0"
                               Foreground="{StaticResource DashboardTextMutedBrush}" FontSize="12"/>
                    <TextBlock x:Name="OpeningBalanceText" Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
                               Foreground="{StaticResource DashboardTextPrimaryBrush}"
                               FontSize="12" HorizontalAlignment="Right"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Expected Cash" Margin="0,8,0,0"
                               Foreground="{StaticResource DashboardTextSecondaryBrush}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ExpectedCashText" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0"
                               Foreground="#34D399" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Payment breakdown (read-only info) -->
            <Border Background="{StaticResource DashboardBackgroundBrush}"
                    BorderBrush="{StaticResource DashboardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="SALES THIS SHIFT"
                               Foreground="{StaticResource DashboardTextMutedBrush}"
                               FontSize="11" Margin="0,0,0,8"/>
                    <StackPanel x:Name="PaymentBreakdownPanel"/>
                    <Separator Background="{StaticResource DashboardBorderBrush}" Margin="0,6"/>
                    <Grid>
                        <TextBlock Text="Total Sales"
                                   Foreground="{StaticResource DashboardTextSecondaryBrush}"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TotalSalesText"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource DashboardTextPrimaryBrush}"
                                   FontSize="13" FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Cashier who is closing -->
            <TextBlock Text="Closed By (Cashier Name)" Foreground="{StaticResource DashboardTextSecondaryBrush}"
                       FontSize="13" Margin="0,0,0,6"/>
            <TextBox x:Name="ClosedByBox"
                     Background="{StaticResource DashboardBackgroundBrush}"
                     Foreground="{StaticResource DashboardTextPrimaryBrush}"
                     BorderBrush="{StaticResource DashboardBorderBrush}"
                     BorderThickness="1" Padding="10,8" FontSize="14" Margin="0,0,0,14"
                     MaxLength="80" Text="Cashier"/>

            <!-- Actual cash -->
            <TextBlock Text="Actual Cash in Drawer (RM)" Foreground="{StaticResource DashboardTextSecondaryBrush}"
                       FontSize="13" Margin="0,0,0,6"/>
            <TextBox x:Name="ActualCashBox"
                     Background="{StaticResource DashboardBackgroundBrush}"
                     Foreground="{StaticResource DashboardTextPrimaryBrush}"
                     BorderBrush="{StaticResource DashboardBorderBrush}"
                     BorderThickness="1" Padding="10,8" FontSize="14" Margin="0,0,0,6"
                     MaxLength="12" Text="0.00"
                     TextChanged="ActualCashBox_TextChanged"/>

            <!-- Live discrepancy preview -->
            <Border x:Name="DiscrepancyPreviewBorder" CornerRadius="6" Padding="10,8"
                    Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <fa:IconBlock x:Name="DiscrepancyIcon" FontSize="16" Margin="0,0,8,0"
                                  VerticalAlignment="Center"/>
                    <TextBlock x:Name="DiscrepancyPreviewText"
                               FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Notes -->
            <TextBlock Text="Notes (optional)" Foreground="{StaticResource DashboardTextSecondaryBrush}"
                       FontSize="13" Margin="0,0,0,6"/>
            <TextBox x:Name="NotesBox"
                     Background="{StaticResource DashboardBackgroundBrush}"
                     Foreground="{StaticResource DashboardTextPrimaryBrush}"
                     BorderBrush="{StaticResource DashboardBorderBrush}"
                     BorderThickness="1" Padding="10,8" FontSize="13"
                     Height="56" TextWrapping="Wrap" AcceptsReturn="True"
                     Margin="0,0,0,16" MaxLength="300"/>

            <!-- Error message -->
            <TextBlock x:Name="ErrorText" Foreground="#F87171" FontSize="12"
                       Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Height="40"
                        Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click"/>
                <Button Grid.Column="2" x:Name="ConfirmBtn" Content="Close Shift" Height="40"
                        Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click"/>
            </Grid>

        </StackPanel>
    </Border>
</UserControl>
