<UserControl x:Class="EZPos.UI.Dialogs.OpenShiftDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Width="440">

    <Border Margin="18" Padding="20" Background="{StaticResource DashboardSurfaceBrush}"
            BorderBrush="{StaticResource DashboardBorderBrush}" BorderThickness="1" CornerRadius="10">
        <StackPanel>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <fa:IconBlock Icon="CashRegister" Foreground="{StaticResource DashboardAccentBrush}"
                              FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Open Shift" Foreground="{StaticResource DashboardTextPrimaryBrush}"
                           FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Cashier Name -->
            <TextBlock Text="Cashier Name" Foreground="{StaticResource DashboardTextSecondaryBrush}"
                       FontSize="13" Margin="0,0,0,6"/>
            <TextBox x:Name="CashierNameBox"
                     Background="{StaticResource DashboardBackgroundBrush}"
                     Foreground="{StaticResource DashboardTextPrimaryBrush}"
                     BorderBrush="{StaticResource DashboardBorderBrush}"
                     BorderThickness="1" Padding="10,8" FontSize="14" Margin="0,0,0,16"
                     MaxLength="80" Text="Cashier" />

            <!-- Opening Balance -->
            <TextBlock Text="Opening Balance (RM)" Foreground="{StaticResource DashboardTextSecondaryBrush}"
                       FontSize="13" Margin="0,0,0,6"/>
            <TextBox x:Name="OpeningBalanceBox"
                     Background="{StaticResource DashboardBackgroundBrush}"
                     Foreground="{StaticResource DashboardTextPrimaryBrush}"
                     BorderBrush="{StaticResource DashboardBorderBrush}"
                     BorderThickness="1" Padding="10,8" FontSize="14" Margin="0,0,0,6"
                     MaxLength="12" Text="0.00"/>
            <TextBlock x:Name="BalanceHint"
                       Text="Enter the physical cash placed in the drawer at shift start."
                       Foreground="{StaticResource DashboardTextMutedBrush}"
                       FontSize="11" Margin="0,0,0,20" TextWrapping="Wrap"/>

            <!-- Error message -->
            <TextBlock x:Name="ErrorText" Foreground="#F87171" FontSize="12"
                       Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Height="40"
                        Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click"/>
                <Button Grid.Column="2" x:Name="ConfirmBtn" Content="Open Shift" Height="40"
                        Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click"/>
            </Grid>

        </StackPanel>
    </Border>
</UserControl>
