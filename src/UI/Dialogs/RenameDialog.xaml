<UserControl x:Class="EZPos.UI.Dialogs.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360">

    <Border BorderBrush="{StaticResource DashboardBorderBrush}" BorderThickness="1"
            Background="{StaticResource DashboardBackgroundBrush}">
        <StackPanel Margin="20,16">
            <TextBlock x:Name="PromptText"
                       Foreground="{StaticResource DashboardTextSecondaryBrush}"
                       FontSize="12" Margin="0,0,0,8" />
            <TextBox x:Name="NameBox"
                     Height="36" FontSize="13"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,14"
                     KeyDown="NameBox_KeyDown" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="34" Padding="16,0" Margin="0,0,8,0"
                        Click="CancelBtn_Click" />
                <Button Content="Rename"
                        Style="{StaticResource DashboardRaisedButton}"
                        Height="34" Padding="16,0"
                        Click="OkBtn_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
