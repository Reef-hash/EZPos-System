<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- ═══════════════ GRAPHITE + AMBER PALETTE ═══════════════ -->
    <SolidColorBrush x:Key="DashboardPrimaryBrush"       Color="#F59E0B" />
    <SolidColorBrush x:Key="DashboardAccentBrush"        Color="#FCD34D" />
    <SolidColorBrush x:Key="DashboardHoverBrush"         Color="#E88E07" />
    <SolidColorBrush x:Key="DashboardBackgroundBrush"    Color="#111014" />
    <SolidColorBrush x:Key="DashboardSurfaceBrush"       Color="#1C1B22" />
    <SolidColorBrush x:Key="DashboardSurface2Brush"      Color="#232229" />
    <SolidColorBrush x:Key="DashboardTextPrimaryBrush"   Color="#FAFAFA" />
    <SolidColorBrush x:Key="DashboardTextSecondaryBrush" Color="#A1A1AA" />
    <SolidColorBrush x:Key="DashboardTextMutedBrush"     Color="#71717A" />
    <SolidColorBrush x:Key="DashboardBorderBrush"        Color="#2E2D38" />

    <!-- Backward-compat aliases (used by pages/MainWindow with old names) -->
    <SolidColorBrush x:Key="PrimaryBrush"         Color="#F59E0B" />
    <SolidColorBrush x:Key="AccentBrush"          Color="#FCD34D" />
    <SolidColorBrush x:Key="TextPrimaryBrush"     Color="#FAFAFA" />
    <SolidColorBrush x:Key="TextSecondaryBrush"   Color="#A1A1AA" />
    <SolidColorBrush x:Key="TextMutedBrush"       Color="#71717A" />
    <SolidColorBrush x:Key="BorderBrush"          Color="#2E2D38" />
    <SolidColorBrush x:Key="SidebarBrush"         Color="#FFFFFF" />
    <SolidColorBrush x:Key="DividerBrush"         Color="#1E2E2D38" />
    <SolidColorBrush x:Key="CardBackgroundBrush"  Color="#232229" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#1AF59E0B" />
    <SolidColorBrush x:Key="SuccessBrush"         Color="#10B981" />
    <SolidColorBrush x:Key="WarningBrush"         Color="#F97316" />
    <SolidColorBrush x:Key="ErrorBrush"           Color="#EF4444" />
    <SolidColorBrush x:Key="InfoBrush"            Color="#F59E0B" />

    <!-- ═══════════════ FONT RESOURCES ═══════════════ -->
    <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Courier New</FontFamily>

    <!-- ═══════════════ ALIAS BRUSHES (used by dialogs) ═══════════════ -->
    <!-- ContentBrush: window/panel background for popup windows -->
    <SolidColorBrush x:Key="ContentBrush" Color="#1C1B22" />

    <!-- ═══════════════ BUTTONS (MaterialDesign-based) ═══════════════ -->

    <!-- Primary action — Cyber Violet filled, rounded -->
    <Style x:Key="DashboardRaisedButton" TargetType="Button"
           BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Secondary / outlined -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button"
           BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8" />
        <Setter Property="Foreground"   Value="{StaticResource DashboardTextPrimaryBrush}" />
        <Setter Property="BorderBrush"  Value="{StaticResource DashboardBorderBrush}" />
    </Style>

    <!-- Sidebar nav — flat, full-width, left-aligned -->
    <Style x:Key="NavButtonStyle" TargetType="Button"
           BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="Height"                     Value="42" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment"        Value="Stretch" />
        <Setter Property="Margin"                     Value="0,2" />
        <Setter Property="Padding"                    Value="14,0" />
        <Setter Property="FontSize"                   Value="13" />
        <Setter Property="Foreground"                 Value="{StaticResource DashboardTextSecondaryBrush}" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8" />
    </Style>

    <!-- Alias — PrimaryButtonStyle == DashboardRaisedButton -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button"
           BasedOn="{StaticResource DashboardRaisedButton}" />

    <!-- Window close button — flat, red on hover -->
    <Style x:Key="WinCloseButtonStyle" TargetType="Button"
           BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="Width"   Value="28" />
        <Setter Property="Height"  Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource DashboardTextSecondaryBrush}" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════ DIALOG FORM STYLES ═══════════════ -->

    <!-- Field label — small muted caption above each input -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource DashboardTextSecondaryBrush}" />
        <Setter Property="FontSize"    Value="12" />
        <Setter Property="Margin"      Value="0,0,0,4" />
    </Style>

    <!-- Validation error message below a field -->
    <Style x:Key="ErrorLabel" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource ErrorBrush}" />
        <Setter Property="FontSize"    Value="11" />
        <Setter Property="Margin"      Value="0,2,0,0" />
        <Setter Property="Visibility"  Value="Collapsed" />
    </Style>

    <!-- Field group — vertical spacing between form fields -->
    <Style x:Key="FieldGroup" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- ═══════════════ CARD (Border wrapper) ═══════════════ -->
    <Style x:Key="DashboardCardStyle" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource DashboardSurfaceBrush}" />
        <Setter Property="BorderBrush"     Value="{StaticResource DashboardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="12" />
        <Setter Property="Padding"         Value="22,18" />
        <Setter Property="Margin"          Value="0,0,0,16" />
    </Style>

    <!-- POS cart list item -->
    <Style x:Key="PosListItemStyle" TargetType="Border">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderBrush"     Value="{StaticResource DashboardBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding"         Value="8,10" />
        <Setter Property="Margin"          Value="0" />
    </Style>

    <!-- ═══════════════ DATAGRID — Violet Theme ═══════════════ -->
    <Style x:Key="DashboardDataGrid" TargetType="DataGrid">
        <Setter Property="Background"               Value="Transparent" />
        <Setter Property="BorderThickness"          Value="0" />
        <Setter Property="RowBackground"            Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="#06F59E0B" />
        <Setter Property="Foreground"               Value="{StaticResource DashboardTextPrimaryBrush}" />
        <Setter Property="GridLinesVisibility"      Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#1A2E2D38" />
        <Setter Property="VerticalGridLinesBrush"   Value="Transparent" />
        <Setter Property="SelectionMode"            Value="Single" />
        <Setter Property="SelectionUnit"            Value="FullRow" />
        <Setter Property="CanUserResizeRows"        Value="False" />
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"      Value="Transparent" />
                    <Setter Property="Foreground"      Value="#FCD34D" />
                    <Setter Property="FontWeight"      Value="Bold" />
                    <Setter Property="FontSize"        Value="11" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush"     Value="#302E2D38" />
                    <Setter Property="Padding"         Value="16,10" />
                    <Setter Property="Height"          Value="40" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background"      Value="Transparent" />
                    <Setter Property="BorderBrush"     Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground"      Value="{StaticResource DashboardTextPrimaryBrush}" />
                    <Setter Property="Height"          Value="46" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#18F59E0B" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#0EF59E0B" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>

        <!-- Cell style: correct padding, vertical centering, focus ring removed -->
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding"                  Value="16,0" />
                    <Setter Property="BorderThickness"          Value="0" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background"  Value="Transparent" />
                            <Setter Property="Foreground"  Value="{StaticResource DashboardTextPrimaryBrush}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ DATAGRID CELL TEXT — shared ElementStyle for DataGridTextColumn ═══ -->
    <!-- Prevents text wrapping/vertical stacking. Apply as ElementStyle on each  -->
    <!-- DataGridTextColumn. Auto-ToolTip reveals truncated text on hover.         -->
    <Style x:Key="DgCellText" TargetType="TextBlock">
        <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
        <Setter Property="TextWrapping"      Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ToolTip"           Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
    </Style>

    <!-- ═══ TRUNCATING LABEL — KPI values, card text, standalone labels ═══ -->
    <!-- For any TextBlock outside a DataGrid that must never wrap.           -->
    <Style x:Key="TruncText" TargetType="TextBlock">
        <Setter Property="TextTrimming"      Value="CharacterEllipsis" />
        <Setter Property="TextWrapping"      Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
