<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- MaterialDesign resources already loaded globally via App.xaml BundledTheme -->

    <!-- ═══════════════ CYBER VIOLET PALETTE ═══════════════ -->
    <SolidColorBrush x:Key="DashboardPrimaryBrush"       Color="#7C3AED" />
    <SolidColorBrush x:Key="DashboardAccentBrush"        Color="#A78BFA" />
    <SolidColorBrush x:Key="DashboardHoverBrush"         Color="#9F67FF" />
    <SolidColorBrush x:Key="DashboardBackgroundBrush"    Color="#0D0D1A" />
    <SolidColorBrush x:Key="DashboardSurfaceBrush"       Color="#13132A" />
    <SolidColorBrush x:Key="DashboardSurface2Brush"      Color="#1A1A35" />
    <SolidColorBrush x:Key="DashboardTextPrimaryBrush"   Color="#F1F5F9" />
    <SolidColorBrush x:Key="DashboardTextSecondaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="DashboardTextMutedBrush"     Color="#6B7280" />
    <SolidColorBrush x:Key="DashboardBorderBrush"        Color="#2D2B55" />

    <!-- ═══════════════ BUTTON — Cyber Violet ═══════════════ -->
    <Style x:Key="DashboardRaisedButton" TargetType="Button">
        <Setter Property="FontFamily"      Value="{StaticResource AppFont}" />
        <Setter Property="FontSize"        Value="12" />
        <Setter Property="FontWeight"      Value="SemiBold" />
        <Setter Property="Foreground"      Value="White" />
        <Setter Property="Background"      Value="{StaticResource DashboardPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding"         Value="14,8" />
        <Setter Property="Cursor"          Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="8" SnapsToDevicePixels="True">
                        <Border.Background>
                            <SolidColorBrush x:Name="BtnBg" Color="#7C3AED"/>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="BtnBg"
                                                    Storyboard.TargetProperty="Color"
                                                    To="#9F67FF" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="BtnBg"
                                                    Storyboard.TargetProperty="Color"
                                                    To="#7C3AED" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════ HEADER CARD ═══════════════ -->
    <Style x:Key="DashboardCardStyle" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource DashboardSurfaceBrush}" />
        <Setter Property="BorderBrush"     Value="{StaticResource DashboardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="12" />
        <Setter Property="Padding"         Value="22,18" />
        <Setter Property="Margin"          Value="0,0,0,16" />
    </Style>

    <!-- ═══════════════ DATAGRID — Violet Theme ═══════════════ -->
    <Style x:Key="DashboardDataGrid" TargetType="DataGrid">
        <Setter Property="Background"              Value="Transparent" />
        <Setter Property="BorderBrush"             Value="{StaticResource DashboardBorderBrush}" />
        <Setter Property="BorderThickness"         Value="0" />
        <Setter Property="RowBackground"           Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="#06A78BFA" />
        <Setter Property="Foreground"              Value="{StaticResource DashboardTextPrimaryBrush}" />
        <Setter Property="GridLinesVisibility"     Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#1A2D2B55" />
        <Setter Property="VerticalGridLinesBrush"  Value="Transparent" />
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"      Value="Transparent" />
                    <Setter Property="Foreground"      Value="#A78BFA" />
                    <Setter Property="FontWeight"      Value="Bold" />
                    <Setter Property="FontSize"        Value="11" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush"     Value="#302D2B55" />
                    <Setter Property="Padding"         Value="16,10" />
                    <Setter Property="Height"          Value="40" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background"      Value="Transparent" />
                    <Setter Property="BorderBrush"     Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground"      Value="{StaticResource DashboardTextPrimaryBrush}" />
                    <Setter Property="Height"          Value="46" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#187C3AED" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#0EA78BFA" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>