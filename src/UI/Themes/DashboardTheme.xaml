<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- ═══════════════ CYBER VIOLET PALETTE ═══════════════ -->
    <SolidColorBrush x:Key="DashboardPrimaryBrush"       Color="#7C3AED" />
    <SolidColorBrush x:Key="DashboardAccentBrush"        Color="#A78BFA" />
    <SolidColorBrush x:Key="DashboardHoverBrush"         Color="#9F67FF" />
    <SolidColorBrush x:Key="DashboardBackgroundBrush"    Color="#0D0D1A" />
    <SolidColorBrush x:Key="DashboardSurfaceBrush"       Color="#13132A" />
    <SolidColorBrush x:Key="DashboardSurface2Brush"      Color="#1A1A35" />
    <SolidColorBrush x:Key="DashboardTextPrimaryBrush"   Color="#F1F5F9" />
    <SolidColorBrush x:Key="DashboardTextSecondaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="DashboardTextMutedBrush"     Color="#6B7280" />
    <SolidColorBrush x:Key="DashboardBorderBrush"        Color="#2D2B55" />

    <!-- Backward-compat aliases (used by pages/MainWindow with old names) -->
    <SolidColorBrush x:Key="PrimaryBrush"         Color="#7C3AED" />
    <SolidColorBrush x:Key="AccentBrush"          Color="#A78BFA" />
    <SolidColorBrush x:Key="TextPrimaryBrush"     Color="#F1F5F9" />
    <SolidColorBrush x:Key="TextSecondaryBrush"   Color="#94A3B8" />
    <SolidColorBrush x:Key="TextMutedBrush"       Color="#6B7280" />
    <SolidColorBrush x:Key="BorderBrush"          Color="#2D2B55" />
    <SolidColorBrush x:Key="SidebarBrush"         Color="#FFFFFF" />
    <SolidColorBrush x:Key="DividerBrush"         Color="#1E2D2B55" />
    <SolidColorBrush x:Key="CardBackgroundBrush"  Color="#1A1A35" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#1A7C3AED" />
    <SolidColorBrush x:Key="SuccessBrush"         Color="#10B981" />
    <SolidColorBrush x:Key="WarningBrush"         Color="#F59E0B" />
    <SolidColorBrush x:Key="ErrorBrush"           Color="#EF4444" />
    <SolidColorBrush x:Key="InfoBrush"            Color="#7C3AED" />

    <!-- ═══════════════ FONT RESOURCES ═══════════════ -->
    <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Courier New</FontFamily>

    <!-- ═══════════════ ALIAS BRUSHES (used by dialogs) ═══════════════ -->
    <!-- ContentBrush: window/panel background for popup windows -->
    <SolidColorBrush x:Key="ContentBrush" Color="#13132A" />

    <!-- ═══════════════ BUTTONS (MaterialDesign-based) ═══════════════ -->

    <!-- Primary action — Cyber Violet filled, rounded -->
    <Style x:Key="DashboardRaisedButton" TargetType="Button"
           BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Secondary / outlined -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button"
           BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8" />
        <Setter Property="Foreground"   Value="{StaticResource DashboardTextPrimaryBrush}" />
        <Setter Property="BorderBrush"  Value="{StaticResource DashboardBorderBrush}" />
    </Style>

    <!-- Sidebar nav — flat, full-width, left-aligned -->
    <Style x:Key="NavButtonStyle" TargetType="Button"
           BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="Height"                     Value="42" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment"        Value="Stretch" />
        <Setter Property="Margin"                     Value="0,2" />
        <Setter Property="Padding"                    Value="14,0" />
        <Setter Property="FontSize"                   Value="13" />
        <Setter Property="Foreground"                 Value="{StaticResource DashboardTextSecondaryBrush}" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8" />
    </Style>

    <!-- Alias — PrimaryButtonStyle == DashboardRaisedButton -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button"
           BasedOn="{StaticResource DashboardRaisedButton}" />

    <!-- Window close button — flat, red on hover -->
    <Style x:Key="WinCloseButtonStyle" TargetType="Button"
           BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="Width"   Value="28" />
        <Setter Property="Height"  Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource DashboardTextSecondaryBrush}" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════ DIALOG FORM STYLES ═══════════════ -->

    <!-- Field label — small muted caption above each input -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource DashboardTextSecondaryBrush}" />
        <Setter Property="FontSize"    Value="12" />
        <Setter Property="Margin"      Value="0,0,0,4" />
    </Style>

    <!-- Validation error message below a field -->
    <Style x:Key="ErrorLabel" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource ErrorBrush}" />
        <Setter Property="FontSize"    Value="11" />
        <Setter Property="Margin"      Value="0,2,0,0" />
        <Setter Property="Visibility"  Value="Collapsed" />
    </Style>

    <!-- Field group — vertical spacing between form fields -->
    <Style x:Key="FieldGroup" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- ═══════════════ CARD (Border wrapper) ═══════════════ -->
    <Style x:Key="DashboardCardStyle" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource DashboardSurfaceBrush}" />
        <Setter Property="BorderBrush"     Value="{StaticResource DashboardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="12" />
        <Setter Property="Padding"         Value="22,18" />
        <Setter Property="Margin"          Value="0,0,0,16" />
    </Style>

    <!-- POS cart list item -->
    <Style x:Key="PosListItemStyle" TargetType="Border">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderBrush"     Value="{StaticResource DashboardBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding"         Value="8,10" />
        <Setter Property="Margin"          Value="0" />
    </Style>

    <!-- ═══════════════ DATAGRID — Violet Theme ═══════════════ -->
    <Style x:Key="DashboardDataGrid" TargetType="DataGrid">
        <Setter Property="Background"               Value="Transparent" />
        <Setter Property="BorderThickness"          Value="0" />
        <Setter Property="RowBackground"            Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="#06A78BFA" />
        <Setter Property="Foreground"               Value="{StaticResource DashboardTextPrimaryBrush}" />
        <Setter Property="GridLinesVisibility"      Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#1A2D2B55" />
        <Setter Property="VerticalGridLinesBrush"   Value="Transparent" />
        <Setter Property="SelectionMode"            Value="Single" />
        <Setter Property="SelectionUnit"            Value="FullRow" />
        <Setter Property="CanUserResizeRows"        Value="False" />
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"      Value="Transparent" />
                    <Setter Property="Foreground"      Value="#A78BFA" />
                    <Setter Property="FontWeight"      Value="Bold" />
                    <Setter Property="FontSize"        Value="11" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush"     Value="#302D2B55" />
                    <Setter Property="Padding"         Value="16,10" />
                    <Setter Property="Height"          Value="40" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background"      Value="Transparent" />
                    <Setter Property="BorderBrush"     Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground"      Value="{StaticResource DashboardTextPrimaryBrush}" />
                    <Setter Property="Height"          Value="46" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#187C3AED" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#0EA78BFA" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
