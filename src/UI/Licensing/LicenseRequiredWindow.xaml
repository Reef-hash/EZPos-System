<Window x:Class="EZPos.UI.Licensing.LicenseRequiredWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="EZPos — Activate License"
        Width="480" Height="420"
        MinWidth="420" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource ContentBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="0" CaptionHeight="0"
                      GlassFrameThickness="0" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- custom title bar -->
                <RowDefinition Height="*"    />   <!-- content -->
            </Grid.RowDefinitions>

            <!-- ── Custom title bar ── -->
            <Grid Grid.Row="0" Background="{StaticResource SidebarBrush}"
                  Height="44" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <fa:IconBlock Icon="Key" FontSize="14" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="EZPos — License Activation"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- ── Content ── -->
            <StackPanel x:Name="ActivationForm" Grid.Row="1" Margin="36,28,36,28" VerticalAlignment="Top">

                <!-- Icon + heading -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                    <fa:IconBlock Icon="ShieldHalved" FontSize="42"
                                  Foreground="{StaticResource PrimaryBrush}"
                                  HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="Activate Your License"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="SubtitleText"
                               Text="Enter your license key to continue."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />

                    <!-- Wake-up indicator (hidden until needed) -->
                    <StackPanel x:Name="WakePanel" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,8,0,0"
                                Visibility="Collapsed">
                        <fa:IconBlock Icon="CircleNotch" FontSize="12"
                                      Foreground="{StaticResource PrimaryBrush}"
                                      VerticalAlignment="Center" Margin="0,0,6,0">
                            <fa:IconBlock.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" CenterX="6" CenterY="6" />
                            </fa:IconBlock.RenderTransform>
                            <fa:IconBlock.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360"
                                                             Duration="0:0:1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </fa:IconBlock.Triggers>
                        </fa:IconBlock>
                        <TextBlock x:Name="WakeStatusText"
                                   Text="Connecting to server..."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Key input -->
                <TextBlock Text="License Key" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" Margin="0,0,0,6" />
                <TextBox x:Name="LicenseKeyBox"
                         Height="40"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         CharacterCasing="Upper"
                         KeyDown="LicenseKeyBox_KeyDown" />

                <!-- Status message -->
                <TextBlock x:Name="StatusText"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="12" Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <!-- Activate button -->
                <Button x:Name="ActivateBtn"
                        Content="Activate"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="42" Margin="0,16,0,0"
                        FontSize="14"
                        Click="ActivateBtn_Click" />

                <!-- Footer -->
                <TextBlock Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11" TextAlignment="Center" Margin="0,16,0,0"
                           TextWrapping="Wrap"
                           Text="Need a license? Contact support or visit ezpos.io" />
            </StackPanel>

            <!-- ── Activation success panel (hidden until success) ── -->
            <StackPanel x:Name="SuccessPanel" Grid.Row="1" Margin="36,28,36,28"
                        VerticalAlignment="Top" Visibility="Collapsed">

                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                    <fa:IconBlock Icon="CircleCheck" FontSize="48"
                                  Foreground="#FF22C55E"
                                  HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="License Activated"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="EZPos is now licensed on this device."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <!-- License detail card -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="8" Padding="18,14" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Plan"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,16,0" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SuccessPlanText"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="License Type"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,16,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SuccessExpiryText"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Customer"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,16,0" />
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SuccessCustomerText"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <Button x:Name="ContinueBtn"
                        Content="Continue to EZPos"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="42" FontSize="14"
                        Click="ContinueBtn_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
